<UserControl x:Class="StudyHud.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource TitleFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="220"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,4,0">
                <TextBlock Text="Settings" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.7"
                           Text="Changes are saved locally to %LOCALAPPDATA%\StudyHud\settings.json. Theme and Hold-to-Interact apply immediately on Save."/>

                <!-- Presentation -->
                <TextBlock Text="Presentation" Style="{StaticResource SectionHeader}"/>
                <StackPanel Style="{StaticResource Row}">
                    <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ThemeCombo"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                    <TextBlock Text="Snap distance (px)" Style="{StaticResource FieldLabel}"/>
                    <Slider x:Name="SnapSlider" Width="180" Minimum="4" Maximum="40"
                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SnapValue" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                    <TextBlock Text="Show control capsule" Style="{StaticResource FieldLabel}"/>
                    <CheckBox x:Name="ShowCapsuleCheck"/>
                </StackPanel>

                <!-- Hold-to-Interact -->
                <TextBlock Text="Hold-to-Interact" Style="{StaticResource SectionHeader}"/>
                <StackPanel Style="{StaticResource Row}">
                    <TextBlock Text="Trigger type" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TriggerTypeCombo" SelectionChanged="OnTriggerTypeChanged"/>
                </StackPanel>
                <StackPanel x:Name="KeyRow" Style="{StaticResource Row}">
                    <TextBlock Text="Trigger key" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TriggerKeyCombo"/>
                </StackPanel>
                <StackPanel x:Name="MouseRow" Style="{StaticResource Row}">
                    <TextBlock Text="Mouse side button" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MouseButtonCombo"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Opacity="0.55" FontSize="11" Margin="0,2,0,0"
                           Text="Note: Caps Lock still toggles caps state — a dedicated key (e.g. Scroll Lock or a mouse side button) avoids that side effect."/>

                <!-- Coordination -->
                <TextBlock Text="Workspaces &amp; Macros" Style="{StaticResource SectionHeader}"/>
                <StackPanel Style="{StaticResource Row}">
                    <TextBlock Text="Auto-switch macro profile" Style="{StaticResource FieldLabel}"/>
                    <CheckBox x:Name="AutoSwitchProfileCheck"/>
                </StackPanel>

                <!-- Exclusions / background -->
                <TextBlock Text="Exclusions &amp; Background" Style="{StaticResource SectionHeader}"/>
                <StackPanel Style="{StaticResource Row}">
                    <TextBlock Text="Hide HUD in fullscreen apps" Style="{StaticResource FieldLabel}"/>
                    <CheckBox x:Name="HideInFullscreenCheck"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                    <TextBlock Text="Pause heavy indexing on battery" Style="{StaticResource FieldLabel}"/>
                    <CheckBox x:Name="PauseOnBatteryCheck"/>
                </StackPanel>
                <StackPanel Margin="0,4">
                    <TextBlock Text="Excluded applications (one process name per line, without .exe)" Opacity="0.85"/>
                    <TextBox x:Name="ExclusionsBox" Height="80" Margin="0,4,0,0"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="{DynamicResource MonoFontFamily}"/>
                </StackPanel>

                <!-- Assessment -->
                <TextBlock Text="Assessment Mode" Style="{StaticResource SectionHeader}"/>
                <StackPanel Style="{StaticResource Row}">
                    <TextBlock Text="Start in Assessment Mode" Style="{StaticResource FieldLabel}"/>
                    <CheckBox x:Name="AssessmentStartupCheck"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Opacity="0.55" FontSize="11"
                           Text="Non-generative does not automatically mean permitted in every assessment. You must comply with your institution's assessment rules."/>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0"
                Padding="0,10,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="SavedLabel" Text="" Foreground="{DynamicResource SecondaryText}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="RevertButton" Content="Revert" Click="OnRevert"
                        Height="{DynamicResource ButtonHeight}" Padding="14,0"
                        Background="{DynamicResource SecondaryBackground}"
                        Foreground="{DynamicResource PrimaryText}" BorderThickness="0"
                        Cursor="Hand" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="Save" Click="OnSave"
                        Height="{DynamicResource ButtonHeight}" Padding="18,0"
                        Background="{DynamicResource Accent}"
                        Foreground="{DynamicResource PrimaryText}" BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
