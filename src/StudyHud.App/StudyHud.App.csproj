<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StudyHud</AssemblyName>
    <RootNamespace>StudyHud.App</RootNamespace>
    <!-- Per-Monitor V2 DPI awareness is declared in the manifest -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StudyHud.Core\StudyHud.Core.csproj" />
    <ProjectReference Include="..\StudyHud.Windows\StudyHud.Windows.csproj" />
    <ProjectReference Include="..\StudyHud.Overlay\StudyHud.Overlay.csproj" />
    <ProjectReference Include="..\StudyHud.Macros\StudyHud.Macros.csproj" />
    <ProjectReference Include="..\StudyHud.Capture\StudyHud.Capture.csproj" />
    <ProjectReference Include="..\StudyHud.Notion\StudyHud.Notion.csproj" />
    <ProjectReference Include="..\StudyHud.Ocr\StudyHud.Ocr.csproj" />
    <ProjectReference Include="..\StudyHud.Search\StudyHud.Search.csproj" />
    <ProjectReference Include="..\StudyHud.Storage\StudyHud.Storage.csproj" />
    <ProjectReference Include="..\StudyHud.Theming\StudyHud.Theming.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="4.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
  </ItemGroup>
</Project>
