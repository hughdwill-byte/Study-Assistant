<Window x:Class="StudyHud.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Study HUD — Settings"
        Width="900" Height="600"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBackground}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="{DynamicResource ButtonHeight}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="*"/>       <!-- Content -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <TextBlock Text="Study HUD"
                           FontSize="{DynamicResource TitleFontSize}"
                           FontFamily="{DynamicResource TitleFontFamily}"
                           VerticalAlignment="Center"/>

                <!-- Assessment mode indicator -->
                <Border DockPanel.Dock="Right"
                        x:Name="AssessmentBadge"
                        Visibility="Collapsed"
                        Background="#CC4422"
                        CornerRadius="{DynamicResource CornerRadius}"
                        Padding="8,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="● LOCAL / NON-GENERATIVE MODE"
                               FontSize="10"
                               Foreground="White"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- ── Main content area ──────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar navigation -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="0,8">
                <StackPanel>
                    <TextBlock Text="STUDY HUD" Margin="16,8,16,4"
                               FontSize="10" Opacity="0.5"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <Button Content="Home" Margin="8,2" Click="OnShowHome"/>
                    <Button Content="Workspaces" Margin="8,2"
                            Click="OnSwitchWorkspaceNoteTaking"/>
                    <Button Content="Courses" Margin="8,2" Click="OnShowLibrary"/>
                    <Button Content="Macros" Margin="8,2"/>
                    <Button Content="Layouts" Margin="8,2"/>

                    <TextBlock Text="STUDY LIBRARY" Margin="16,16,16,4"
                               FontSize="10" Opacity="0.5"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <Button Content="Notion Sync" Margin="8,2" Click="OnShowLibrary"/>
                    <Button Content="Index Status" Margin="8,2" Click="OnShowLibrary"/>

                    <TextBlock Text="APP" Margin="16,16,16,4"
                               FontSize="10" Opacity="0.5"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <Button Content="Assessment Mode" Margin="8,2"
                            Click="OnToggleAssessmentMode"/>
                    <Button Content="Themes" Margin="8,2" Click="OnShowSettings"/>
                    <Button Content="Settings" Margin="8,2" Click="OnShowSettings"/>
                </StackPanel>
            </Border>

            <!-- Main panel (pages rendered here) -->
            <Border Grid.Column="1" Padding="20">
                <ContentControl x:Name="PageHost">
                    <StackPanel x:Name="HomeView">
                        <TextBlock Text="Welcome to Study HUD"
                                   FontSize="{DynamicResource TitleFontSize}"
                                   FontFamily="{DynamicResource TitleFontFamily}"
                                   Margin="0,0,0,12"/>

                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="Use the sidebar to configure workspaces, courses, macros, layouts, and your Notion library. The HUD runs in the background — this window manages settings only."/>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Note Taking" Margin="0,0,8,0"
                                    Click="OnSwitchWorkspaceNoteTaking"/>
                            <Button Content="Question Finder"
                                    Click="OnSwitchWorkspaceQuestionFinder"/>
                            <Button Content="Toggle HUD" Margin="8,0,0,0"
                                    Click="OnToggleHudVisibility"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Border>
        </Grid>

        <!-- ── Status bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="WorkspaceStatusLabel"
                           Text="Workspace: Note Taking"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="{DynamicResource SmallFontSize}"/>
                <TextBlock x:Name="CourseStatusLabel"
                           Text="No course"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="{DynamicResource SmallFontSize}"
                           Margin="16,0,0,0"/>
                <TextBlock x:Name="AssessmentIndicator"
                           Text="● ASSESSMENT MODE"
                           Foreground="#FF6644"
                           FontSize="{DynamicResource SmallFontSize}"
                           Margin="16,0,0,0"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="WorkspaceLabel" Visibility="Collapsed"/>
                <TextBlock x:Name="CourseLabel" Visibility="Collapsed"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
